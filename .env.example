# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Configured for Hostinger domain sheikcoin.site
APP_URL="https://sheikcoin.site"

# VITE_API_URL: The backend API endpoint deployed on Render
# Used when the frontend is statically hosted on Hostinger
VITE_API_URL="https://maestriagrill-backend.onrender.com"

# Supabase Integration Credentials (Primary Database & Authentication)
# Obtain these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Only Admin Key (For secure administrative storage uploads with RLS bypass)
# NEVER add VITE_ prefix to this variable. Keep it strictly on the backend.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Mercado Pago Integration Credentials
VITE_MERCADOPAGO_PUBLIC_KEY="APP_USR-45e3bea4-d7ee-4847-af4b-251fba799c6f"
